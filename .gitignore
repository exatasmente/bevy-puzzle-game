# Generated by Cargo
# will have compiled files and executables
/target/

# Cargo.lock is committed: this is an executable, not a library. Without it the
# dependency versions float within their semver ranges on every build, which
# means an unexplained break may be an upstream release rather than a change
# here — and a release build is not reproducible.

# These are backup files generated by rustfmt
**/*.rs.bk

/.metals/
/.vscode/
